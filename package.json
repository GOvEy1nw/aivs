{
  "name": "aivs",
  "version": "0.1.0",
  "description": "AiVS — AI Video Studio. Local-first creative studio powered by WanGP.",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "AI Video Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/GOvEy1nw/aivs.git"
  },
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.30.3"
  },
  "scripts": {
    "setup:dev:mac": "bash scripts/setup-dev.sh",
    "setup:dev:linux": "bash scripts/setup-dev.sh",
    "setup:dev:win": "powershell -ExecutionPolicy Bypass -File scripts/setup-dev.ps1",
    "dev": "vite",
    "dev:debug": "cross-env BACKEND_DEBUG=1 ELECTRON_DEBUG=1 vite",
    "typecheck": "concurrently \"pnpm run typecheck:ts\" \"pnpm run typecheck:py\"",
    "typecheck:ts": "tsc --noEmit",
    "typecheck:py": "cd backend && uv run pyright",
    "test:frontend": "vitest run",
    "test:frontend:watch": "vitest",
    "test:dependency-boundaries": "node --test scripts/check-dependency-boundaries.node-test.mjs",
    "check:package-manager": "node scripts/check-dependency-boundaries.mjs --package-manager",
    "validate:frontend": "pnpm run typecheck:ts && pnpm run test:frontend && pnpm run build:frontend",
    "wangp:check": "powershell -ExecutionPolicy Bypass -File scripts/update-wangp.ps1 -CheckOnly",
    "wangp:validate": "powershell -ExecutionPolicy Bypass -File scripts/update-wangp.ps1",
    "wangp:validate:full": "powershell -ExecutionPolicy Bypass -File scripts/update-wangp.ps1 -Full",
    "test:media-import": "node scripts/test-project-asset-import.mjs",
    "backend:test": "cd backend && uv sync --inexact --frozen --extra test --extra dev && uv run pytest -v --tb=short",
    "build:mac": "bash scripts/local-build.sh --platform mac",
    "build:win": "powershell -ExecutionPolicy Bypass -File scripts/local-build.ps1",
    "build:mac:skip-python": "bash scripts/local-build.sh --platform mac --skip-python",
    "build:win:skip-python": "powershell -ExecutionPolicy Bypass -File scripts/local-build.ps1 -SkipPython",
    "build:fast:mac": "bash scripts/local-build.sh --platform mac --unpack --skip-python",
    "build:fast:win": "powershell -ExecutionPolicy Bypass -File scripts/local-build.ps1 -Unpack -SkipPython",
    "prepare:python:mac": "bash scripts/prepare-python.sh",
    "prepare:python:win": "powershell -ExecutionPolicy Bypass -File scripts/prepare-python.ps1",
    "build:frontend": "vite build",
    "bundle:report": "node scripts/check-renderer-bundle.mjs",
    "start:unpacked:mac": "open release/mac-arm64/AiVS.app",
    "start:unpacked:win": "powershell -Command \"& '.\\release\\win-unpacked\\AiVS.exe'\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^14.2.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.8.1",
    "jsdom": "30.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-electron": "^1.1.0",
    "vitest": "4.1.10"
  }
}
